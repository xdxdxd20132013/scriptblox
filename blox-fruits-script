local function setLocalSky(timeType)
    _G.LocalVisualTime = timeType
    local sky = Lighting:FindFirstChildOfClass("Sky")
    if sky and timeType ~= "Default" then sky:Destroy() end
    if timeType == "Day" then
        Lighting.ClockTime = 14
        Lighting.GeographicLatitude = 41.5
    elseif timeType == "Night" then
        Lighting.ClockTime = 0
        Lighting.GeographicLatitude = 0
    end
end

DayBtn.MouseButton1Click:Connect(function() setLocalSky("Day") end)
