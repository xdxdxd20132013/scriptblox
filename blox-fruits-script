local function takeQuest(questName, questId)
    local remote = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes") and game:GetService("ReplicatedStorage").Remotes:FindFirstChild("CommF_")
    if remote then remote:InvokeServer("StartQuest", questName, questId) end
end
-- ЦИКЛ ФАРМУ СКРИНЬ
task.spawn(function()
    while ScreenGui.Parent do
        task.wait(0.1)
        if _G.ChestFarm then
            local Root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") local chest = getClosestChest()
            if chest and Root and _G.ChestFarm then
                stopMovement() currentBV = Instance.new("BodyVelocity", Root) currentBV.Velocity = Vector3.new(0,0,0) currentBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                currentTween = game:GetService("TweenService"):Create(Root, TweenInfo.new((Root.Position - chest.Position).Magnitude / 350, Enum.EasingStyle.Linear), {CFrame = chest.CFrame})
                currentTween:Play() local completed = false local cConn = currentTween.Completed:Connect(function() completed = true end)
                while not completed and _G.ChestFarm do task.wait(0.01) end cConn:Disconnect() stopMovement() if _G.ChestFarm then task.wait(0.15) end
            end
        end
    end
end)

-- УНІВЕРСАЛЬНИЙ АВТОФАРМ ЛЕВЕЛУ (2 МЕТРИ НАД МОБОМ ДЛЯ 1, 2, 3 МОРЯ)
task.spawn(function()
    local VirtualInputManager = game:GetService("VirtualInputManager")
    while ScreenGui.Parent do
        task.wait(0.02)
        if _G.LevelFarm then
            pcall(function()
                local Character = Player.Character local Root = Character and Character:FindFirstChild("HumanoidRootPart") local Humanoid = Character and Character:FindFirstChild("Humanoid")
                if not Root or not Humanoid or Humanoid.Health <= 0 then return end
                
                local currentTool = Character:FindFirstChildOfClass("Tool")
                if not currentTool then
                    for _, tool in pairs(Player.Backpack:GetChildren()) do
                        if tool:IsA("Tool") and (tool:FindFirstChild("Animate") or tool:FindFirstChild("Skill") or string.find(string.lower(tool.Name), "sword") or tool.Name == "Combat" or string.find(string.lower(tool.Name), "style")) then
                            Humanoid:EquipTool(tool) break
                        end
                    end
                end
                
                local targetMobName, questName, questId = getMyLevelMobName()
                local hasQuest = Player.PlayerGui:FindFirstChild("Main") and Player.PlayerGui.Main:FindFirstChild("Quest") and Player.PlayerGui.Main.Quest.Visible
                if not hasQuest then takeQuest(questName, questId) task.wait(0.3) return end
                
                local mob = nil
                if workspace:FindFirstChild("Enemies") then
                    for _, enemy in pairs(workspace.Enemies:GetChildren()) do if enemy.Name == targetMobName and enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then mob = enemy break end end
                end
                if not mob then
                    for _, enemy in pairs(workspace:GetChildren()) do if enemy.Name == targetMobName and enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then mob = enemy break end end
                end
                
                if mob and _G.LevelFarm then
                    stopMovement() Root.CFrame = mob.HumanoidRootPart.CFrame * CFrame.new(0, 2, 0)
                    if not Root:FindFirstChild("FarmVelocity") then
                        local bv = Instance.new("BodyVelocity") bv.Name = "FarmVelocity" bv.Velocity = Vector3.new(0,0,0) bv.MaxForce = Vector3.new(9e9, 9e9, 9e9) bv.Parent = Root
                    end
                    for _, otherEnemy in pairs(workspace:GetChildren()) do
                        if otherEnemy.Name == targetMobName and otherEnemy ~= mob and otherEnemy:FindFirstChild("HumanoidRootPart") then if (mob.HumanoidRootPart.Position - otherEnemy.HumanoidRootPart.Position).Magnitude < 45 then otherEnemy.HumanoidRootPart.CFrame = mob.HumanoidRootPart.CFrame otherEnemy.HumanoidRootPart.CanCollide = false end end
                    end
                    if workspace:FindFirstChild("Enemies") then
                        for _, otherEnemy in pairs(workspace.Enemies:GetChildren()) do
                            if otherEnemy.Name == targetMobName and otherEnemy ~= mob and otherEnemy:FindFirstChild("HumanoidRootPart") then if (mob.HumanoidRootPart.Position - otherEnemy.HumanoidRootPart.Position).Magnitude < 45 then otherEnemy.HumanoidRootPart.CFrame = mob.HumanoidRootPart.CFrame otherEnemy.HumanoidRootPart.CanCollide = false end end
                        end
                    end
                    VirtualInputManager:ClickButton1(Vector2.new(0, 0))
                else if Root and Root:FindFirstChild("FarmVelocity") then Root.FarmVelocity:Destroy() end end
            end)
        else local Root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") if Root and Root:FindFirstChild("FarmVelocity") then Root.FarmVelocity:Destroy() end end
    end
end)
