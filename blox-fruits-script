-- ДОПОМІЖНІ ФУНКЦІЇ ДЛЯ ФАРМУ
local function getClosestChest()
    local closest, dist = nil, math.huge
    local Root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if not Root then return nil end
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("TouchTransmitter") and obj.Parent and string.find(obj.Parent.Name, "Chest") then
            local chest = obj.Parent
            local part = chest:IsA("BasePart") and chest or chest:FindFirstChildOfClass("BasePart")
            if part then
                local d = (Root.Position - part.Position).Magnitude
                if d < dist then closest = part; dist = d end
            end
        end
    end
    return closest
end

local function getMyLevelMobName()
    if not Player:FindFirstChild("Data") or not Player.Data:FindFirstChild("Level") then return "Bandit", "BanditQuest1", 1 end
    local lv = Player.Data.Level.Value
    if lv < 10 then return "Bandit", "BanditQuest1", 1
    elseif lv < 15 then return "Monkey", "JungleQuest", 1
    elseif lv < 30 then return "Gorilla", "JungleQuest", 2
    elseif lv < 60 then return "Pirate", "PirateIslandQuest", 1
    elseif lv < 90 then return "Brute", "PirateIslandQuest", 2
    elseif lv < 120 then return "Snow Soldier", "SnowQuest", 1
    elseif lv < 150 then return "Snowman", "SnowQuest", 2
    elseif lv < 175 then return "Chief Petty Officer", "MarineQuest2", 1
    else return "Sky Bandit", "SkyQuest", 1 end
end

local function takeQuest(questName, questId)
    local remote = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes") and game:GetService("ReplicatedStorage").Remotes:FindFirstChild("CommF_")
    if remote then remote:InvokeServer("StartQuest", questName, questId) end
end
-- ЦИКЛ ФАРМУ СКРИНЬ
task.spawn(function()
    while ScreenGui.Parent do
        task.wait(0.1)
        if _G.ChestFarm then
            local Root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
            local chest = getClosestChest()
            if chest and Root and _G.ChestFarm then
                stopMovement()
                currentBV = Instance.new("BodyVelocity", Root)
                currentBV.Velocity = Vector3.new(0,0,0)
                currentBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                
                currentTween = game:GetService("TweenService"):Create(Root, TweenInfo.new((Root.Position - chest.Position).Magnitude / 350, Enum.EasingStyle.Linear), {CFrame = chest.CFrame})
                currentTween:Play()
                
                local completed = false
                local cConn = currentTween.Completed:Connect(function() completed = true end)
                while not completed and _G.ChestFarm do task.wait(0.01) end
                cConn:Disconnect()
                
                stopMovement()
                if _G.ChestFarm then task.wait(0.15) end
            end
        end
    end
end)

-- АВТОФАРМ ЛЕВЕЛУ
task.spawn(function()
    while ScreenGui.Parent do
        task.wait(0.1)
        if _G.LevelFarm then
            pcall(function()
                local Character = Player.Character
                local Root = Character and Character:FindFirstChild("HumanoidRootPart")
                local Humanoid = Character and Character:FindFirstChild("Humanoid")
                if not Root or not Humanoid or Humanoid.Health <= 0 then return end

                local currentTool = Character:FindFirstChildOfClass("Tool")
                if not currentTool or (currentTool.ToolTip ~= "Melee" and currentTool.ToolTip ~= "Sword") then
                    for _, tool in pairs(Player.Backpack:GetChildren()) do
                        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.ToolTip == "Sword") then
                            Humanoid:EquipTool(tool)
                            break
                        end
                    end
                end

                local targetMobName, questName, questId = getMyLevelMobName()
                local hasQuest = Player.PlayerGui:FindFirstChild("Main") and Player.PlayerGui.Main:FindFirstChild("Quest") and Player.PlayerGui.Main.Quest.Visible
                
                if not hasQuest then
                    takeQuest(questName, questId)
                    task.wait(0.5)
                    return
                end

                local mobFound = false
                for _, enemy in pairs(workspace:GetChildren()) do
                    if enemy.Name == targetMobName and enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                        mobFound = true
                        stopMovement()
                        Root.CFrame = enemy.HumanoidRootPart.CFrame * CFrame.new(0, 5, 0)
                        
                        if not Root:FindFirstChild("FarmVelocity") then
                            local bv = Instance.new("BodyVelocity")
                            bv.Name = "FarmVelocity"
                            bv.Velocity = Vector3.new(0,0,0)
                            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                            bv.Parent = Root
                        end
                        
                        local tool = Character:FindFirstChildOfClass("Tool")
                        if tool then tool:Activate() end
                        
                        for _, otherEnemy in pairs(workspace:GetChildren()) do
                            if otherEnemy.Name == targetMobName and otherEnemy ~= enemy and otherEnemy:FindFirstChild("HumanoidRootPart") then
                                if (enemy.HumanoidRootPart.Position - otherEnemy.HumanoidRootPart.Position).Magnitude < 40 then
                                    otherEnemy.HumanoidRootPart.CFrame = enemy.HumanoidRootPart.CFrame
                                    otherEnemy.HumanoidRootPart.CanCollide = false
                                end
                            end
                        end
                        break
                    end
                end

                if not mobFound and workspace:FindFirstChild("Enemies") then
                    for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                        if enemy.Name == targetMobName and enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                            Root.CFrame = enemy.HumanoidRootPart.CFrame * CFrame.new(0, 5, 0)
                            local tool = Character:FindFirstChildOfClass("Tool")
                            if tool then tool:Activate() end
                            break
                        end
                    end
                end
            end)
        else
            local Root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
            if Root and Root:FindFirstChild("FarmVelocity") then Root.FarmVelocity:Destroy() end
        end
    end
end)

-- КОНТРОЛЕР ПЛАВНОГО ПОЛЬОТУ
task.spawn(function()
    local flyBV, flyBG
    while ScreenGui.Parent do
        task.wait()
        local Character = Player.Character
        local Root = Character and Character:FindFirstChild("HumanoidRootPart")
        local Humanoid = Character and Character:FindFirstChild("Humanoid")
        local Camera = workspace.CurrentCamera
        
        if _G.FlyMode and Root and Humanoid and Camera then
            if not flyBV then
                flyBV = Instance.new("BodyVelocity", Root)
                flyBV.Name = "XenoFlyVelocity"
                flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                flyBG = Instance.new("BodyGyro", Root)
                flyBG.Name = "XenoFlyGyro"
                flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            end
            
            flyBG.CFrame = Camera.CFrame
            local direction = Humanoid.MoveDirection
            local velocity = direction * _G.FlySpeed
            
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                velocity = velocity + Vector3.new(0, _G.FlySpeed, 0)
            elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                velocity = velocity + Vector3.new(0, -_G.FlySpeed, 0)
            end
            
            if direction.Magnitude == 0 and not UserInputService:IsKeyDown(Enum.KeyCode.Space) and not UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                flyBV.Velocity = Vector3.new(0, 0.1, 0)
            else
                flyBV.Velocity = velocity
            end
        else
            if flyBV then flyBV:Destroy() flyBV = nil end
            if flyBG then flyBG:Destroy() flyBG = nil end
        end
    end
end)

